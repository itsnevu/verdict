# ── server ──
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# ── storage (compose sets DATABASE_URL / REDIS_URL for you; leave empty to run fully in memory) ──
# Required by docker-compose; use a long random value.
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=
SNAPSHOT_RETENTION_DAYS=30

# ── data sources ──
# DexScreener public API, chain id as DexScreener spells it
DEX_BASE_URL=https://api.dexscreener.com
DEX_CHAIN_ID=robinhood
# Robinhood Chain (chain id 4663) JSON-RPC. Holders are rebuilt from Transfer logs over the last RPC_LOG_RANGE blocks.
# Must serve eth_getLogs over ranges: globalstake, thirdweb, pocket, tatum do; publicnode needs a token.
# Blocks are ~0.1s, so 400000 blocks is roughly 11 hours of Transfer history.
RPC_URL=https://rpc-robinhood.globalstake.io
RPC_LOG_RANGE=400000
# BasedBot launch metadata. Path is a template; {address} is replaced. Stays complete:false until verified.
BASEDBOT_BASE_URL=
BASEDBOT_LAUNCH_PATH=/v1/tokens/{address}
BASEDBOT_SCHEMA_VERIFIED=0
# Switch adapters off by name to test degraded mode: dexscreener,rpc,basedbot
DISABLE_SOURCES=
# 1 = also serve the bundled synthetic fixtures (tokens 0x…a001-a005). Handy for demos.
USE_MOCK_SOURCE=0

# ── access ──
# API keys and their scopes: key:scope1|scope2,key2:scope
# Generate each key with: openssl rand -hex 24   (production refuses keys shorter than 24 chars or starting with dev/test/demo)
# Only sha256 hashes of these keys are stored.
API_KEYS=
# Number of reverse proxies in front of the API. 0 = ignore X-Forwarded-For (clients could spoof it).
TRUST_PROXY_HOPS=0
# Local dev only: allow http:// webhooks and MCP probe targets.
ALLOW_INSECURE_URLS=0
QUOTA_UNITS_PER_DAY=500
SCAN_CACHE_SECONDS=45
LEADERBOARD_MIN_CALLS=200

# ── onchain: VerdictOracle on Robinhood Chain (see contracts/README.md) ──
# Leave ORACLE_ADDRESS empty to run without onchain features.
ORACLE_ADDRESS=
ORACLE_CHAIN_ID=4663
# Defaults to RPC_URL
ORACLE_RPC_URL=
# Hot key that may ONLY call attest(). Never the owner key. Empty = read-only.
ATTESTER_PRIVATE_KEY=

# ── worker ──
WORKER_INTERVAL_SECONDS=60
